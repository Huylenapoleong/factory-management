# ==============================================================================
# Factory Management System - Environment Configuration Template
# Copy this file to .env and modify values for your deployment
# ==============================================================================

# Application Branding & White-label
APP_NAME=Smart Factory
COMPANY_NAME=ABC Manufacturing Co., Ltd.
COMPANY_LOGO_URL=
COMPANY_ADDRESS="123 Industrial Park, District 1, Ho Chi Minh City"
COMPANY_TAX_CODE=0102030405
COMPANY_PHONE=+84 28 1234 5678
COMPANY_EMAIL=contact@example.com

# Regional & Localization
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,zh-CN
DEFAULT_CURRENCY=USD
TIMEZONE=Asia/Shanghai
DATE_FORMAT=YYYY-MM-DD
NUMBER_FORMAT="#,##0.00"

# Feature Flags
FEATURE_INVENTORY=true
FEATURE_PURCHASING=true
FEATURE_PRODUCTION=true
FEATURE_SALES=true
FEATURE_REPORTING=true

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=factory_db
DB_USERNAME=factory_user
DB_PASSWORD=change_me_factory_password_2026

# Backend Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# JWT Authentication
# Secret must be at least 256 bits (32 characters) for HS256 / HS512
JWT_SECRET=change_me_super_secret_key_factory_management_2026_at_least_32_bytes_long!
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# CORS Whitelist (comma-separated URLs)
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# Frontend Public API URL (for production reverse proxy)
VITE_API_BASE_URL=/api/v1
